DATABASE_URL="postgresql://postgres:SENHA@localhost:5432/VorenMe"
PORT=8081
JWT_SECRET_APP="troque-por-um-segredo-longo"
JWT_SECRET_REFRESH="troque-por-outro-segredo-longo"
JWT_EXPIRES_IN="3h"
# Origem do vorenMe_app em produção (ex: https://vorenme.com). Vazio = sem CORS (dev usa o proxy do Vite).
FRONT_URL=""
# E-mails com acesso ao /admin (conta já criada e e-mail confirmado), separados por vírgula.
ADMIN_EMAILS=""
# Atrás de proxy reverso: 1 (número de proxies). Vazio = conexão direta.
TRUST_PROXY=""
# Asaas: sandbox https://api-sandbox.asaas.com/v3 · produção https://api.asaas.com/v3
ASAAS_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY=""
# Mesmo token configurado no webhook do Asaas (POST /api/v1/billing/webhook)
ASAAS_WEBHOOK_TOKEN=""
# E-mail: use SMTP (Gmail) OU Resend. Nenhum dos dois = e-mails aparecem só no console (dev).
# Gmail: SMTP_PASS é uma "senha de app" (myaccount.google.com/apppasswords), não a senha normal.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Resend (https://resend.com):
RESEND_API_KEY=""
MAIL_FROM="VorenMe <nao-responda@vorenme.com>"
